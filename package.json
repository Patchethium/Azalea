{
  "name": "azalea",
  "version": "0.2.3",
  "description": "A lightweight, unofficial VOICEVOX GUI",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "check": "oxlint -c .oxlintrc.jsonc src/ && oxfmt -c .oxfmtrc.jsonc --check src/ && tsc --noEmit",
    "format": "oxfmt -c .oxfmtrc.jsonc --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cargo llvm-cov --branch --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "test:all": "pnpm check && pnpm build && pnpm test:coverage && cargo test --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "dev:landing": "pnpm --filter @azalea/landing dev",
    "build:landing": "pnpm --filter @azalea/landing build",
    "preview:landing": "pnpm --filter @azalea/landing preview",
    "check:landing": "oxlint -c .oxlintrc.jsonc apps/landing/src packages/theme/src && oxfmt -c .oxfmtrc.jsonc --check apps/landing packages/theme && pnpm --filter @azalea/landing check",
    "build:all": "pnpm build && pnpm build:landing"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@corvu/unocss": "^0.1.3",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/context": "0.3.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tanstack/solid-virtual": "^3.13.37",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/lodash": "^4.17.24",
    "@unocss/reset": "catalog:",
    "lodash": "^4.18.1",
    "path-browserify": "^1.0.1",
    "solid-js": "catalog:",
    "@azalea/theme": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/path-browserify": "^1.0.3",
    "@unocss/preset-icons": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-primitives": "0.0.2-beta.1",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "^4.1.10"
  },
  "private": true
}
