{
  "name": "azalea",
  "version": "0.2.3",
  "description": "A lightweight, unofficial VOICEVOX GUI",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "start": "pnpm run dev",
    "fonts": "node scripts/download-fonts.mjs",
    "dev": "pnpm run fonts && vite",
    "build": "pnpm run fonts && vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "check": "oxlint -c .oxlintrc.jsonc src/ && oxfmt -c .oxfmtrc.jsonc --check src/ && tsc --noEmit",
    "format": "oxfmt -c .oxfmtrc.jsonc --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cargo llvm-cov --branch --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "test:all": "pnpm check && pnpm build && pnpm test:coverage && cargo test --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@corvu/unocss": "^0.1.3",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/context": "0.3.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tanstack/solid-virtual": "^3.13.48",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@types/lodash": "^4.17.26",
    "@unocss/reset": "66.2.0",
    "lodash": "^4.18.1",
    "path-browserify": "^1.0.1",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/path-browserify": "^1.0.3",
    "@unocss/preset-icons": "66.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unocss": "66.2.0",
    "unocss-preset-primitives": "0.0.2-beta.1",
    "vite": "^6.4.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.12"
  }
}
