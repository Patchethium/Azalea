{
  "name": "azalea",
  "version": "0.2.2",
  "description": "A lightweight, unofficial VOICEVOX GUI",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "check": "oxlint --config oxlint.json src/ && oxfmt --check src/",
    "format": "oxfmt --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:build": "pnpm tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "test:e2e": "pnpm test:e2e:build && pnpm test:e2e:run",
    "test:all": "pnpm check && pnpm build && pnpm test:coverage && cargo test --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    },
    "patchedDependencies": {
      "@wdio/tauri-service@1.2.0": "patches/@wdio__tauri-service@1.2.0.patch"
    }
  },
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@corvu/unocss": "^0.1.3",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/context": "0.3.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/lodash": "^4.17.24",
    "@unocss/reset": "66.2.0",
    "lodash": "^4.18.1",
    "path-browserify": "^1.0.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/path-browserify": "^1.0.3",
    "@unocss/preset-icons": "66.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unocss": "66.2.0",
    "unocss-preset-primitives": "0.0.2-beta.1",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  }
}
