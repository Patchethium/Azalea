{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "azalea",
  "version": "0.4.1",
  "identifier": "com.azalea.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Azalea",
        "decorations": false,
        "width": 1000,
        "height": 800,
        "minHeight": 600,
        "minWidth": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NDQ1NjYzRUUwNEU3NDAKUldSQTV3VHVZMVpFNmEyZW04MGZ6T2tPWFVSaVFvdVhSSHM1NjRlNUkvVnRXSWN2bFJQWFNxZzYK",
      "endpoints": [
        "https://github.com/Patchethium/Azalea/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["azp"],
        "name": "Azalea Project",
        "description": "Azalea project file",
        "role": "Editor",
        "mimeType": "application/x-azalea-project",
        "exportedType": {
          "identifier": "com.azalea.app.project",
          "conformsTo": ["public.plain-text"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
